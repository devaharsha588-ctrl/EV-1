{
  "name": "ev-ai-backend",
  "version": "1.0.0",
  "description": "EV AI (Evolution Vector) production-ready backend API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node ./node_modules/nodemon/bin/nodemon.js src/server.js",
    "start": "node src/server.js",
    "check": "node scripts/check.js",
    "verify:env": "node scripts/verify-env.js",
    "verify:external": "node scripts/verify-external.js",
    "smoke": "node scripts/smoke.js",
    "db:status": "node scripts/db-status.js",
    "test": "node ./node_modules/jest/bin/jest.js",
    "db:migrate": "node ./node_modules/sequelize-cli/lib/sequelize db:migrate",
    "db:migrate:undo": "node ./node_modules/sequelize-cli/lib/sequelize db:migrate:undo",
    "db:seed": "node ./node_modules/sequelize-cli/lib/sequelize db:seed:all"
  },
  "keywords": [
    "express",
    "sequelize",
    "mysql",
    "ai",
    "career"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.11.5",
    "nodemailer": "^9.0.4",
    "openai": "^4.77.0",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
