PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ev_ai
DB_USER=root
DB_PASSWORD=replace_with_database_password

JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_REFRESH_EXPIRE=7d

COOKIE_SECRET=replace_with_long_random_cookie_secret

AI_PROVIDER=openai
OPENAI_API_KEY=replace_with_openai_api_key
GROK_API_KEY=replace_with_grok_api_key
GROK_BASE_URL=https://api.x.ai/v1
OPENROUTER_API_KEY=replace_with_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=no-reply@example.com
SMTP_TEST_TO=test@example.com

LOG_LEVEL=info
OPENAI_MODEL=gpt-4o-mini
GROK_MODEL=grok-4
OPENROUTER_MODEL=anthropic/claude-3-opus

SUPABASE_URL=replace_with_supabase_url
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
VITE_SUPABASE_URL=replace_with_supabase_url
VITE_SUPABASE_ANON_KEY=replace_with_supabase_anon_key

